        "import re\n",
        "\n",
        "# Specify the URL here\n",
        "url = \"http://192.168.1.10/login/verify\"\n",
        "\n",
        "keywords = [\"login\", \"verify\", \"bank\", \"secure\", \"update\", \"paypal\"]\n",
        "\n",
        "score = 0\n",
        "\n",
        "if \"@\" in url:\n",
        "    score += 1\n",
        "\n",
        "if len(url) > 60:\n",
        "    score += 1\n",
        "\n",
        "if re.search(r\"\\d+\\.\\d+\\.\\d+\\.\\d+\", url):\n",
        "    score += 1\n",
        "\n",
        "for word in keywords:\n",
        "    if word in url.lower():\n",
        "        score += 1\n",
        "\n",
        "print(\"URL:\", url)\n",
        "\n",
        "if score >= 2:\n",
        "    print(\"⚠ Phishing URL Detected\")\n",
        "else:\n",
        "    print(\"✔ Safe URL\")"
      ]
    }
