        "import socket\n",
        "\n",
        "target = \"127.0.0.1\"\n",
        "\n",
        "print(f\"Scanning Target: {target}\\n\")\n",
        "\n",
        "for port in range(20, 1025):\n",
        "    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
        "    sock.settimeout(0.5)\n",
        "\n",
        "    result = sock.connect_ex((target, port))\n",
        "\n",
        "    if result == 0:\n",
        "        print(f\"Port {port} is OPEN\")\n",
        "\n",
        "    sock.close()\n",
        "\n",
        "print(\"\\nScan Completed.\")"
      ]
