        "# 1. Threat Intelligence Application Area\n",
        "\n",
        "scenario = input(\"Enter business scenario: \").lower()\n",
        "\n",
        "if any(word in scenario for word in [\"bank\", \"banking\", \"payment\", \"credit card\", \"transaction\"]):\n",
        "    area = \"Banking Fraud Prevention\"\n",
        "elif any(word in scenario for word in [\"hospital\", \"healthcare\", \"patient\", \"medical\"]):\n",
        "    area = \"Healthcare Data Protection\"\n",
        "elif any(word in scenario for word in [\"online store\", \"e-commerce\", \"shopping\", \"customer\"]):\n",
        "    area = \"E-commerce Fraud Prevention\"\n",
        "elif any(word in scenario for word in [\"government\", \"public sector\"]):\n",
        "    area = \"Government Cybersecurity\"\n",
        "else:\n",
        "    area = \"General Cyber Threat Monitoring\"\n",
        "\n",
        "print(\"Threat Intelligence Application Area:\", area)"
