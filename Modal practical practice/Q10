      "source": [
        "connections = set()\n",
        "\n",
        "packets = [\n",
        "    (\"OUTBOUND\", \"client\", \"server\", 80),\n",
        "    (\"INBOUND\", \"server\", \"client\", 80),\n",
        "    (\"INBOUND\", \"unknown\", \"client\", 22)\n",
        "]\n",
        "\n",
        "for direction, source, destination, port in packets:\n",
        "\n",
        "    if direction == \"OUTBOUND\":\n",
        "        connections.add((source, destination, port))\n",
        "        print(\"OUTBOUND:\", \"PERMITTED\")\n",
        "\n",
        "    else:\n",
        "        if (destination, source, port) in connections:\n",
        "            print(\"INBOUND:\", \"PERMITTED - Return Traffic\")\n",
        "        else:\n",
        "            print(\"INBOUND:\", \"BLOCKED - Unsolicited\")"
      ]
    }
