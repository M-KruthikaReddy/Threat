      ],
      "source": [
        "alert = input(\"Enter SOC alert: \").lower()\n",
        "\n",
        "if any(x in alert for x in [\"ransomware\", \"data breach\", \"active attack\"]):\n",
        "    priority = \"P1 - Critical\"\n",
        "elif any(x in alert for x in [\"malware\", \"privilege escalation\"]):\n",
        "    priority = \"P2 - High\"\n",
        "elif any(x in alert for x in [\"phishing\", \"suspicious login\"]):\n",
        "    priority = \"P3 - Medium\"\n",
        "else:\n",
        "    priority = \"P4 - Low\"\n",
        "\n",
        "print(\"Priority:\", priority)"
