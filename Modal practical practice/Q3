          "text": [
            "Enter security policy text: This policy defines the scope and roles of employees. It is reviewed annually.\n",
            "Missing Elements:\n",
            "- Enforcement\n",
            "- Approval Authority\n"
          ]
        }
      ],
      "source": [
        "policy = input(\"Enter security policy text: \").lower()\n",
        "\n",
        "requirements = {\n",
        "    \"Scope\": [\"scope\"],\n",
        "    \"Roles and Responsibilities\": [\"roles\", \"responsibilities\"],\n",
        "    \"Enforcement\": [\"enforcement\"],\n",
        "    \"Review Cycle\": [\"review\", \"annually\"],\n",
        "    \"Approval Authority\": [\"approved by\", \"approval\"]\n",
        "}\n",
        "\n",
        "missing = []\n",
        "\n",
        "for requirement, keywords in requirements.items():\n",
        "    if not any(word in policy for word in keywords):\n",
        "        missing.append(requirement)\n",
        "\n",
        "if missing:\n",
        "    print(\"Missing Elements:\")\n",
        "    for item in missing:\n",
        "        print(\"-\", item)\n",
        "else:\n",
        "    print(\"All governance elements are present.\")"
      ]
    }
