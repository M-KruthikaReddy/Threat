            "Enter report description: Report about attacker techniques and MITRE tactics\n",
            "Enter intended audience: Security analysts\n",
            "Classification: Tactical\n"
          ]
        }
      ],
      "source": [
        "description = input(\"Enter report description: \").lower()\n",
        "audience = input(\"Enter intended audience: \").lower()\n",
        "\n",
        "text = description + \" \" + audience\n",
        "\n",
        "strategic = [\"executive\", \"management\", \"business\", \"risk\", \"long term\"]\n",
        "tactical = [\"attacker\", \"technique\", \"mitre\", \"campaign\"]\n",
        "operational = [\"ip\", \"domain\", \"hash\", \"ioc\", \"incident\"]\n",
        "\n",
        "scores = {\n",
        "    \"Strategic\": sum(x in text for x in strategic),\n",
        "    \"Tactical\": sum(x in text for x in tactical),\n",
        "    \"Operational\": sum(x in text for x in operational)\n",
        "}\n",
        "\n",
        "print(\"Classification:\", max(scores, key=scores.get))"
      ]
    }
  ]
