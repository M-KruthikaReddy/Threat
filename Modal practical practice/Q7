            "Indexed Events:\n",
            "{'level': 'INFO', 'event': 'login', 'user': 'kruthi'}\n",
            "{'level': 'ERROR', 'event': 'failed_login', 'user': 'admin'}\n",
            "{'level': 'INFO', 'event': 'login', 'user': 'kruthi'}\n",
            "{'level': 'ERROR', 'event': 'failed_login', 'user': 'admin'}\n",
            "\n",
            "Event Counts:\n",
            "login : 2\n",
            "failed_login : 2\n"
          ]
        }
      ],
      "source": [
        "from collections import Counter\n",
        "\n",
        "logs = [\n",
        "    \"INFO login user=kruthi\",\n",
        "    \"ERROR failed_login user=admin\",\n",
        "    \"INFO login user=kruthi\",\n",
        "    \"ERROR failed_login user=admin\"\n",
        "]\n",
        "\n",
        "events = []\n",
        "\n",
        "# Logstash\n",
        "for log in logs:\n",
        "    parts = log.split()\n",
        "\n",
        "    events.append({\n",
        "        \"level\": parts[0],\n",
        "        \"event\": parts[1],\n",
        "        \"user\": parts[2].split(\"=\")[1]\n",
        "    })\n",
        "\n",
        "# Elasticsearch\n",
        "index = events\n",
        "\n",
        "print(\"Indexed Events:\")\n",
        "for event in index:\n",
        "    print(event)\n",
        "\n",
        "# Kibana\n",
        "counts = Counter(event[\"event\"] for event in events)\n",
        "\n",
        "print(\"\\nEvent Counts:\")\n",
        "for event, count in counts.items():\n",
        "    print(event, \":\", count)"
      ]
    }
